# Public site URL — drives canonicals, og:url, og:image, and the sitemap.
# Optional: defaults to https://halvo.io if unset. Set this if you deploy to a
# different domain (e.g. a temporary Railway URL) so those links aren't wrong.
VITE_SITE_URL="https://halvo.io"

# Optional analytics/ad pixels — only load after cookie consent. Leave blank to
# disable (the consent banner then only manages essential cookies).
VITE_META_PIXEL_ID=""
VITE_GA_MEASUREMENT_ID=""
