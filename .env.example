# Supabase (new, independent project — not shared with Kitsly)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (test mode to start)
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Anthropic (AI copywriter)
ANTHROPIC_API_KEY=""

# Resend — purchase confirmations, sale notifications, download recovery.
# WITHOUT THIS, NO EMAIL IS SENT AT ALL. The code degrades safely (a purchase
# still completes and the download still works) and logs a line per skipped
# message, so the failure is silent to the buyer.
RESEND_API_KEY=""

# The address email is sent FROM. Leave blank and it falls back to Resend's
# sandbox sender, onboarding@resend.dev — which ONLY delivers to the inbox that
# owns the Resend account. That is the trap: you test with your own address, it
# arrives, you assume email works, and every real buyer silently gets nothing
# (Resend returns 403, logged server-side but invisible to them).
#
# Set this to an address on a domain you have VERIFIED in Resend, e.g.
# hello@halvo.io, before taking a real payment.
EMAIL_FROM_ADDRESS=""

# Public site URL — drives canonicals, og:url, og:image, and the sitemap.
# Optional: defaults to https://halvo.io if unset. Set this if you deploy to a
# different domain (e.g. a temporary Railway URL) so those links aren't wrong.
VITE_SITE_URL="https://halvo.io"

# Which social sign-in buttons the /login page shows, in this order. Unset means
# just Google, which is what it offered before this existed.
#
#   VITE_AUTH_PROVIDERS="google,apple,facebook,github"
#
# Supported: google, apple, facebook, github, linkedin (linkedin_oidc),
# microsoft (azure), discord, x. Unknown names are ignored.
#
# EACH ONE MUST ALSO BE ENABLED IN SUPABASE (Authentication > Providers) with
# that provider's own client id and secret — listing it here only draws the
# button, and a button for a provider Supabase doesn't have fails on click.
#
# Costs/effort per provider, roughly:
#   github, linkedin, discord  — free, ~10 minutes
#   facebook                   — free, but Meta requires app review
#   apple                      — needs an Apple Developer account ($99/yr)
#   microsoft                  — free, Azure app registration
#
# NOTE: VITE_* is inlined at BUILD time — set it in Railway and redeploy.
VITE_AUTH_PROVIDERS=""

# Optional analytics/ad pixels — only load after cookie consent. Leave blank to
# disable (the consent banner then only manages essential cookies).
VITE_META_PIXEL_ID=""
VITE_GA_MEASUREMENT_ID=""

# Cloudflare Web Analytics — the owner's view of traffic: visits, page views,
# top pages, referrers, countries, devices, Core Web Vitals.
#
# Cookieless, so unlike the two pixels above it is NOT gated behind the consent
# banner and no banner appears because of it. That is the point: no "reject"
# clicks means no undercounting. It does NOT measure how long visitors stay —
# use Plausible/GA4, or Microsoft Clarity for session recordings, if you need that.
#
# Get the token: Cloudflare dashboard > Web Analytics > your site > Manage site.
#
# ONLY set this if the site is served directly (e.g. Railway, DNS-only). If the
# domain is proxied through Cloudflare, use Cloudflare's automatic setup instead
# and leave this blank — doing both injects the beacon twice and double-counts
# every visit.
#
# NOTE: VITE_* vars are inlined at BUILD time. Setting this locally does nothing
# for production — set it in Railway and redeploy.
VITE_CF_BEACON_TOKEN=""

# ── Direct charges ───────────────────────────────────────────────────────────
# "true" switches purchases from DESTINATION charges to DIRECT charges on the
# seller's connected account. What changes:
#   · the seller's account pays Stripe's processing fee and any dispute fee
#   · the money never passes through the platform balance
#   · the platform fee drops from 7% + 35c to a flat 5% (see plans.ts)
#   · refunds return the platform fee and have no transfer to reverse
#
# MONEY-CRITICAL. Leave this "false" until every item in
# docs/on-behalf-of-migration-plan.md passes in Stripe TEST mode.
VITE_STRIPE_DIRECT_CHARGES="false"

# Required only when VITE_STRIPE_DIRECT_CHARGES is "true". Direct-charge events
# fire on the connected account and arrive from a SEPARATE Connect endpoint in
# the Stripe dashboard ("Listen to events on Connected accounts"), which has its
# own signing secret. Point it at the same /api/public/payments/webhook URL and
# paste its secret here — the platform secret will not verify those events.
STRIPE_CONNECT_WEBHOOK_SECRET=""
